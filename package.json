{
  "name": "queuer",
  "version": "0.1.0",
  "description": "Queue management application",
  "author": "Your Name",
  "private": true,
  "type": "module",
  "main": "electron.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "next build && NODE_ENV=production electron .",
    "pack": "next build && electron-builder --dir",
    "pack:win": "next build && electron-builder --win --dir",
    "pack:linux": "next build && electron-builder --linux --dir",
    "dist": "next build && electron-builder",
    "dist:win": "next build && electron-builder --win",
    "dist:win-portable": "next build && electron-builder --win portable",
    "dist:mac": "next build && electron-builder --mac",
    "dist:linux": "next build && electron-builder --linux"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "next": "16.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "build": {
    "appId": "com.queuer.app",
    "productName": "Queuer",
    "files": [
      "electron.mjs",
      "preload.cjs",
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "public/**/*",
      "data/**/*",
      "src/utils/db.js"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
